ENVIRONMENT=development

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector store
CHROMA_PERSIST_DIR=./chroma_store
KB_COLLECTION_NAME=support_knowledge_base

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS - comma-separated handled via python list in config; edit config.py default or override via JSON list
CORS_ORIGINS=["http://localhost:5173"]
